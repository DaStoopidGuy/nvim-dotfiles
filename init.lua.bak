-- Keymaps
-- -----------------------
vim.g.mapleader = " "
vim.g.maplocalleader = " "

-- clear highlights on search when <Esc> is pressed
vim.keymap.set("n", "<Esc>", "<cmd>nohlsearch<CR>")

-- exit terminal mode with <Esc><Esc>-pine
vim.keymap.set("t", "<Esc><Esc>", "<C-\\><C-n>", { desc = "Exit terminal mode" })

-- split navigation
